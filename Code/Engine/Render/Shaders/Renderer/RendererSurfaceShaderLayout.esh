
#ifndef __RENDERER_SURFACE_SHADER_LAYOUT_ESH__
#define __RENDERER_SURFACE_SHADER_LAYOUT_ESH__

#include "Base/Render/RHI.esh"
#include "Engine/Render/Shaders/EngineShader.esh"

// Each shader owns 3 render buckets per view - opaque, alpha test, alpha blend.
// Keep in sync with DeviceRenderView::s_NumRenderBucketsPerViewBucket and MaterialShaderRenderBucket!
#define EE_NUM_RENDER_BUCKETS_PER_SHADER_PER_VIEW 3

EE_BEGIN_SHADER_TYPES_NAMESPACE

    uint GetBucketTypeForView( ShaderParameters shaderParameters, bool renderViewDepthOnly )
    {
        if ( shaderParameters.m_shaderFlags & EE_SHADER_FLAG_ALPHA_TEST )
        {
            return 1;
        }
        if ( ( shaderParameters.m_shaderFlags & EE_SHADER_FLAG_ALPHA_BLEND ) && !renderViewDepthOnly )
        {
            return 2;
        }
        return 0;
    }

EE_END_SHADER_TYPES_NAMESPACE

#endif
