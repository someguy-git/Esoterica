
#include "Base/Render/RHI.esh"
#include "Engine/Render/Shaders/CommonSamplers.esh"
#include "Engine/Render/Shaders/FullscreenTriangle.esh"

#ifndef __cplusplus
ESF_RESOURCE_TABLE struct DepthPyramidReductionResourceTable
{
    Texture2D                   m_inputTexture;
    uint                        m_inputWidth;
    uint                        m_inputHeight;
    uint                        m_inputMipLevel;
};
#endif


#include "Engine/_Module/_AutoGenerated/ShaderReflection/DepthPyramidReduction.esh"

#ifndef __cplusplus

ESF_PARAMETER string ShaderType = "Surface";

#define DepthPyramidReductionRootSignature      EE_BEGIN_ROOT_SIGNATURE \
                                                DepthPyramidReductionResourceTableRootConstant( "b0", "space=0" )

EE_DECLARE_ROOT_CONSTANTS( DepthPyramidReductionResourceTableData, b0, space0 );

[RootSignature( DepthPyramidReductionRootSignature )]
float PS_main( FullscreenTriangleVertexOutput input ) : SV_Target
{
    DepthPyramidReductionResourceTable resourceTable = CreateDepthPyramidReductionResourceTable( RootConstants );
    SamplerState linearClampMinSampler = GetLinearClampMinSampler();

    bool2 oddDimensions = bool2( resourceTable.m_inputWidth % 2 != 0, resourceTable.m_inputHeight % 2 != 0);

    float result = 1.0;

    if ( all( !oddDimensions ) )
    {
        result = resourceTable.m_inputTexture.SampleLevel( linearClampMinSampler, input.m_uv, resourceTable.m_inputMipLevel ).r;
    }

    if ( oddDimensions.x )
    {
        float depth0 = resourceTable.m_inputTexture.SampleLevel( linearClampMinSampler, input.m_uv, resourceTable.m_inputMipLevel, int2( -1, 0 ) ).r;
        float depth1 = resourceTable.m_inputTexture.SampleLevel( linearClampMinSampler, input.m_uv, resourceTable.m_inputMipLevel, int2( 1, 0 ) ).r;
        result = min( result, min( depth0, depth1 ) );
    }

    if ( oddDimensions.y )
    {
        float depth0 = resourceTable.m_inputTexture.SampleLevel( linearClampMinSampler, input.m_uv, resourceTable.m_inputMipLevel, int2( 0, -1 ) ).r;
        float depth1 = resourceTable.m_inputTexture.SampleLevel( linearClampMinSampler, input.m_uv, resourceTable.m_inputMipLevel, int2( 0, 1 ) ).r;
        result = min( result, min( depth0, depth1 ) );
    }

    return result;
}

#endif
