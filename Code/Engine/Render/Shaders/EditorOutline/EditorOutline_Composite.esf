
#include "Base/Render/RHI.esh"
#include "Engine/Render/Shaders/CommonSamplers.esh"
#include "Engine/Render/Shaders/FullscreenTriangle.esh"
#include "Engine/Render/Shaders/EditorOutline/EditorOutline_Common.esh"

#ifndef __cplusplus
ESF_RESOURCE_TABLE struct EditorOutlineCompositeResourceTable
{
    Texture2D                   m_distanceTexture;

    float4                      m_parameters;           // x - outline thickness in pixels, yzw - outline color
};
#endif

#include "Engine/_Module/_AutoGenerated/ShaderReflection/EditorOutline_Composite.esh"

#ifndef __cplusplus

ESF_PARAMETER string ShaderType = "Surface";

#define EditorOutlineCompositeRootSignature       EE_BEGIN_ROOT_SIGNATURE \
                                                  EditorOutlineCompositeResourceTableRootConstant( "b0", "space=0" )

EE_DECLARE_ROOT_CONSTANTS( EditorOutlineCompositeResourceTableData, b0, space0 );

[RootSignature( EditorOutlineCompositeRootSignature )]
float4 PS_main( FullscreenTriangleVertexOutput input ) : SV_Target
{
    EditorOutlineCompositeResourceTable resourceTable = CreateEditorOutlineCompositeResourceTable( RootConstants );
    SamplerState pointSampler = GetPointClampSampler();

    float2 seed = round( resourceTable.m_distanceTexture.SampleLevel( pointSampler, input.m_uv, 0 ).xy * EditorOutline_SeedCoordinateScale );
    float distanceToOutline = length( seed - input.m_position.xy );

    float const halfThickness = resourceTable.m_parameters.x * 0.5;
    float const aaWidth = 1.0;

    float alpha = 1.0 - smoothstep( max( halfThickness - aaWidth, 0.0 ), halfThickness + aaWidth, distanceToOutline );

    return float4( resourceTable.m_parameters.yzw, alpha );
}

#endif
