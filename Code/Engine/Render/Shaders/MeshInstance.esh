
#include "Engine/Render/Shaders/Transform.esh"
#include "Engine/Render/Shaders/MeshData.esh"
#include "Engine/Render/Shaders/CommonFlags.esh"

#ifndef _MESH_INSTANCE_ESH_
#define _MESH_INSTANCE_ESH_

EE_BEGIN_SHADER_TYPES_NAMESPACE

    #ifdef __cplusplus
    // Compressed world AABB - 12 bytes: 12-bit shared exponent + six 14-bit two's complement mantissas.
    // The center is stored relative to the transform origin.
    struct CompressedAABB
    {
        uint32_t m_data[3];

        inline uint32_t& operator[]( uint32_t index ) { return m_data[index]; }
        inline uint32_t const& operator[]( uint32_t index ) const { return m_data[index]; }
    };

    // Packs a world AABB into the compressed layout, see DecompressAABB for the decode
    inline CompressedAABB CompressAABB( EE::Float3 center, EE::Float3 halfExtents, EE::Float3 origin )
    {
        float const values[6] =
        {
            center[0] - origin[0],
            center[1] - origin[1],
            center[2] - origin[2],
            halfExtents[0],
            halfExtents[1],
            halfExtents[2],
        };

        float maxAbs = 0.0F;
        for ( uint32_t i = 0; i < 6; ++i )
        {
            maxAbs = Math::Max( maxAbs, Math::Abs( values[i] ) );
        }

        int32_t exponent = -2048;
        if ( maxAbs > 0.0F )
        {
            int32_t e = 0;
            frexpf( maxAbs, &e );
            exponent = Math::Clamp( e - 13, -2048, 2047 );
        }

        int32_t mantissas[6];
        for ( uint32_t i = 0; i < 6; ++i )
        {
            mantissas[i] = Math::Clamp( ( int32_t ) roundf( ldexpf( values[i], -exponent ) ), -8192, 8191 );
        }

        CompressedAABB result = {};
        result[0] = uint32_t( exponent + 2048 ) | ( uint32_t( mantissas[0] ) & 0x3FFF ) << 12 | ( uint32_t( mantissas[1] ) & 0x3F ) << 26;
        result[1] = ( uint32_t( mantissas[1] ) >> 6 & 0xFF ) | ( uint32_t( mantissas[2] ) & 0x3FFF ) << 8 | ( uint32_t( mantissas[3] ) & 0x3FF ) << 22;
        result[2] = ( uint32_t( mantissas[3] ) >> 10 & 0xF ) | ( uint32_t( mantissas[4] ) & 0x3FFF ) << 4 | ( uint32_t( mantissas[5] ) & 0x3FFF ) << 18;
        return result;
    }
    #endif

    #ifndef __cplusplus
    typedef uint3 CompressedAABB;

    // Decompresses a packed world AABB, see CompressAABB for the format
    void DecompressAABB( CompressedAABB packedAABB, float3 transformOrigin, out float3 center, out float3 halfExtents )
    {
        const int exponent = int( packedAABB.x & 0xFFF ) - 2048;

        // 14-bit two's complement sign extension
        const uint raw0 = ( packedAABB.x >> 12 ) & 0x3FFF;
        const uint raw1 = ( ( packedAABB.x >> 26 ) & 0x3F ) | ( ( packedAABB.y & 0xFF ) << 6 );
        const uint raw2 = ( packedAABB.y >> 8 ) & 0x3FFF;
        const uint raw3 = ( ( packedAABB.y >> 22 ) & 0x3FF ) | ( ( packedAABB.z & 0xF ) << 10 );
        const uint raw4 = ( packedAABB.z >> 4 ) & 0x3FFF;
        const uint raw5 = ( packedAABB.z >> 18 ) & 0x3FFF;

        const int m0 = int( ( raw0 ^ 0x2000 ) - 0x2000 );
        const int m1 = int( ( raw1 ^ 0x2000 ) - 0x2000 );
        const int m2 = int( ( raw2 ^ 0x2000 ) - 0x2000 );
        const int m3 = int( ( raw3 ^ 0x2000 ) - 0x2000 );
        const int m4 = int( ( raw4 ^ 0x2000 ) - 0x2000 );
        const int m5 = int( ( raw5 ^ 0x2000 ) - 0x2000 );

        center      = ldexp( float3( m0, m1, m2 ), exponent ) + transformOrigin;
        halfExtents = ldexp( float3( m3, m4, m5 ), exponent );
    }
    #endif

    struct HLSL_ALIGN_STRUCT MeshInstanceRoot
    {
        float3x4                        m_rootTransform;
    
        uint                            m_instanceHidden            : 1;
        RenderViewLayerFlags            m_renderViewLayerFlags      : 8;
        uint                            m_numLODs                   : 8;    // TODO: Max num LODs is 8, put an assert somewhere
        uint                            m_padding                   : 8;
        uint                            m_forceMinLOD               : 3;
        uint                            m_forceLOD                  : 3;
        uint                            m_useForcedLOD              : 1;

        uint                            m_boneOffset;

        CompressedAABB                  m_worldAABB;
        float16_t                       m_lodDistances[8];
        uint                            m_reserved[11];

        #ifdef __cplusplus
        void SetWorldAABB( EE::Float3 center, EE::Float3 halfExtents, EE::Float3 origin )
        {
            m_worldAABB = CompressAABB( center, halfExtents, origin );
        }

        void SetLODDistance( uint32_t lodIndex, float value )
        {
            EE_ASSERT( lodIndex < m_numLODs );

            m_lodDistances[lodIndex] = Math::FloatToHalf( value );
        }
        #endif
    
        #ifndef __cplusplus
        float GetLODDistance( uint lodIndex )
        {
            return m_lodDistances[lodIndex];
        }
    
        void GetWorldAABB( out float3 center, out float3 halfExtents )
        {
            const float3 transformOrigin = float3( m_rootTransform[0].w, m_rootTransform[1].w, m_rootTransform[2].w );

            DecompressAABB( m_worldAABB, transformOrigin, center, halfExtents );
        }
        #endif
    };

    HLSL_STATIC_ASSERT( sizeof( MeshInstanceRoot ) == 128, "Don't exceed 128 bytes for this structure, it is performance critical" );

    struct HLSL_ALIGN_STRUCT MeshInstance
    {
        float3x4                        m_localTransform;

        uint                            m_meshInstanceRootIndex;
        uint                            m_shaderParametersOffsetIn32ByteBlocks;
    
        uint                            m_lodMask                           : 8;
        uint                            m_meshBuffer                        : 16;   // 16-bit bindless buffer handle: one packed mesh == one buffer
        uint                            m_instanceHidden                    : 1;
        uint                            m_reserved                          : 7;

        uint                            m_clusterToInstanceOffset;
    
        #ifndef __cplusplus
        MeshInstanceRoot LoadRoot( StructuredBuffer<MeshInstanceRoot> buffer )
        {
            return buffer[m_meshInstanceRootIndex];
        }

        bool IsVisibleInLOD( uint lodIndex )
        {
            return ( m_lodMask & ( 1U << lodIndex ) ) != 0;
        }
    
        float3x4 ComputeWorldTransform( MeshInstanceRoot meshInstanceRoot )
        {
            float4x4 rootTransform = float4x4
            (
                meshInstanceRoot.m_rootTransform[0],
                meshInstanceRoot.m_rootTransform[1],
                meshInstanceRoot.m_rootTransform[2],
                float4( 0, 0, 0, 1 )
            );
            float4x4 localTransform = float4x4
            (
                m_localTransform[0],
                m_localTransform[1],
                m_localTransform[2],
                float4( 0, 0, 0, 1 )
            );

            float4x4 result = mul( rootTransform, localTransform );
            return ( float3x4 )result;
        }
        #endif
    };

    HLSL_STATIC_ASSERT( sizeof( MeshInstance ) == 64, "Don't exceed 64 bytes for this structure, it is performance critical" );

EE_END_SHADER_TYPES_NAMESPACE

#endif
